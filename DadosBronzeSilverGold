    "REF = \"/Volumes/vooceuazul/bronze/arquivos/REFERENCIA\"\n",
    "\n",
    "aerodromos = (\n",
    "    spark.read.format(\"csv\")\n",
    "    .option(\"sep\", \";\")\n",
